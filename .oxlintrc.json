{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "stylistic/lines-between-class-members": [
      "error",
      {
        "enforce": [
          {
            "blankLine": "always",
            "prev": "*",
            "next": "method"
          },
          {
            "blankLine": "always",
            "prev": "method",
            "next": "*"
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules/**", ".tmp/**", "assets/**"],
  "jsPlugins": [
    {
      "name": "stylistic",
      "specifier": "@stylistic/eslint-plugin"
    }
  ]
}
