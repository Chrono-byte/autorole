{
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        },
        {
          "external": {
            "command": "./node_modules/.bin/oxfmt",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      ],
      "language_servers": ["oxlint", "..."]
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        },
        {
          "external": {
            "command": "./node_modules/.bin/oxfmt",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      ],
      "language_servers": ["oxlint", "..."]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
