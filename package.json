{
  "name": "autorole",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "register": "bun run src/cli/register.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "bun run lint:fix && oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "clean-commands": "bun run src/cli/clean-commands.ts",
    "avatar": "bun run src/cli/set-avatar.ts",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "build:binary": "bun build --compile --target=bun-linux-x64-baseline --env=disable --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/index.ts --outfile dist/autorole",
    "deploy": "sh scripts/deploy.sh"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
