[Unit]
Description=Athena Discord autorole bot

[Service]
Type=notify
NotifyAccess=all
TimeoutStartSec=60
WorkingDirectory=/var/lib/athena
StateDirectory=athena-state
EnvironmentFile=/var/lib/athena/runtime.env
ExecStart=/var/lib/athena/current
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
TimeoutStopFailureMode=kill
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
# Keep homes hidden while allowing Discord readiness notifications.
BindReadOnlyPaths=%t/systemd/notify
ReadOnlyPaths=/var/lib/athena
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
LimitCORE=0

[Install]
WantedBy=default.target
